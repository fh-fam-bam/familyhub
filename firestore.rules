rules_version = '2';
// Family Hub Firestore rules – v39.6 (Stage 6: parent mode on the wall tablet)
// Paste into Firebase console › Firestore Database › Rules, then Publish.
//
// Who is who:
//  - The two old shared logins below keep working exactly as before until you say they can go.
//  - New accounts get their role from /users/{uid}: "parent", "display" (wall tablet) or "kid" (later).
//    Only a parent can create or change /users records.
// Care items (medicines, appointments, dose logs) live in two folders:
//   careParent – parents only. The wall display and kids cannot read it at all.
//   careKid    – parents, the wall display and the old kids' login; a "kid" account only its own items.
// Parent mode on the wall tablet: a 5-minute unlock session, either approved by a parent's phone or opened
// with the wall PIN (checked here against a hash the tablet cannot read). While it lasts, the tablet may make
// the same changes to shared family data as a parent, but still cannot read parent care, PINs or accounts.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- the old shared logins (remove later, only after you confirm) ----
    function isLegacyParent() {
      return request.auth != null && request.auth.uid in ['wL2GTwTYn7Ngjtnyy0NkQ5IKlsZ2'];
    }
    function isLegacyKids() {
      return request.auth != null && request.auth.uid in ['RhyyWQhemQefhVkPQt2EfAhgxDw1'];
    }

    // ---- roles from /users/{uid} ----
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasRole(r) {
      return request.auth != null && exists(userPath()) && get(userPath()).data.role == r;
    }
    function isParent() { return isLegacyParent() || hasRole('parent'); }
    function isKids()   { return isLegacyKids() || hasRole('display') || hasRole('kid'); }
    function isKidRole() { return hasRole('kid'); }
    function myPid()     { return get(userPath()).data.personId; }

    // ---- parent mode on the wall tablet ----
    function sessPath()  { return /databases/$(database)/documents/households/family/unlockSession/$(request.auth.uid); }
    function wallHash()  { return get(/databases/$(database)/documents/households/family/wallSecret/pin).data.hash; }
    function approverIsParent(a) {
      return a in ['wL2GTwTYn7Ngjtnyy0NkQ5IKlsZ2']
        || (exists(/databases/$(database)/documents/users/$(a))
            && get(/databases/$(database)/documents/users/$(a)).data.role == 'parent');
    }
    function inSession() {
      return request.auth != null && isKids() && exists(sessPath())
        && get(sessPath()).data.until > request.time
        && (get(sessPath()).data.kind == 'pin'
              ? get(sessPath()).data.proof == wallHash()
              : approverIsParent(get(sessPath()).data.approvedBy));
    }
    function isParentAct() { return isParent() || inSession(); }

    // ---- account records ----
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasAll(['role', 'personId'])
        && d.keys().hasOnly(['role', 'personId', 'name', 'email', 'updatedBy', 'updatedAt'])
        && d.role in ['parent', 'display', 'kid']
        && d.personId is string
        && (d.role == 'display'
              ? d.personId == 'none'
              : d.personId.matches('^[A-Za-z0-9_-]{1,100}$'))
        && (!('name' in d.keys()) || (d.name is string && d.name.size() <= 80))
        && (!('email' in d.keys()) || (d.email is string && d.email.size() <= 200))
        && (!('updatedBy' in d.keys()) || d.updatedBy == request.auth.uid)
        && (!('updatedAt' in d.keys()) || d.updatedAt is timestamp);
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isParent());
      // A parent cannot change or remove their own role, so nobody locks themselves out by accident.
      allow create, update: if isParent() && validUser()
        && !(uid == request.auth.uid && request.resource.data.role != 'parent');
      allow delete: if isParent() && uid != request.auth.uid;
    }

    // A newly signed-in account asks to be approved (it can only write its own request).
    match /accessRequests/{uid} {
      allow read, delete: if isParent() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.at is timestamp;
    }

    // ---- shared family data (unchanged from v38.25 apart from the role functions) ----
    match /households/family/items/{id} {

      function goodShape() {
        let d = request.resource.data;
        return d.keys().hasAll(['json', 'rev', 'deleted'])
          && d.keys().hasOnly(['json', 'rev', 'deleted', 'ts', 'st'])
          && d.json is string
          && d.json.size() < 100000
          && d.rev is int
          && d.deleted is bool
          && d.rev == (resource == null ? 1 : resource.data.rev + 1)
          && (!('st' in d.keys()) || (d.st is string && d.st.size() <= 1));
      }
      // Kids may only create/update chore records marked pending ('p') or empty,
      // and may never touch one a parent has approved ('a') or one with no marker.
      function kidDoneOk() {
        let d = request.resource.data;
        return 'st' in d.keys() && d.st in ['', 'p']
          && (resource == null
              || ('st' in resource.data.keys() && resource.data.st != 'a'));
      }

      allow read: if isParent() || isKids();

      // a kid account may only check off its own chores
      function ownDone() {
        return !isKidRole() || id.matches('^done__[0-9]{4}-[0-9]{2}-[0-9]{2}__' + myPid() + '__.+$');
      }

      allow create, update: if goodShape() && (
        (isParentAct() && id.matches('^(events|eventRequests|groc|req|boardreq|done|meals|cfg|ledger|hw|stat|slog|cant)__[A-Za-z0-9_-]{1,120}$'))
        ||
        (isKids() && id.matches('^done__[A-Za-z0-9_-]{1,120}$') && kidDoneOk() && ownDone())
        ||
        (isKids() && id.matches('^(eventRequests|req|groc|boardreq|hw)__[A-Za-z0-9_-]{1,120}$')
                  && !('st' in request.resource.data.keys()))
        ||
        // status history: kids' devices may only add new entries for Done, "I couldn't do this" or undoing a check-off
        (isKids() && resource == null && id.matches('^slog__[A-Za-z0-9_-]{1,120}$')
                  && 'st' in request.resource.data.keys() && request.resource.data.st in ['d', 'c', 'p'])
        ||
        // "I couldn't do this" requests: kids' devices may only create new ones
        (isKids() && resource == null && id.matches('^cant__[A-Za-z0-9_-]{1,120}$')
                  && !('st' in request.resource.data.keys()))
      );

      allow delete: if false;
    }

    // ---- care items ----
    function careShape(aud) {
      let d = request.resource.data;
      return d.keys().hasAll(['json', 'rev', 'deleted', 'aud', 'own'])
        && d.keys().hasOnly(['json', 'rev', 'deleted', 'ts', 'st', 'aud', 'own'])
        && d.json is string && d.json.size() < 100000
        && d.rev is int && d.deleted is bool
        && d.rev == (resource == null ? 1 : resource.data.rev + 1)
        && d.aud == aud
        && d.own is string && d.own.size() <= 100
        && (!('st' in d.keys()) || (d.st is string && d.st.size() <= 1));
    }
    match /households/family/careParent/{id} {
      allow read: if isParent();
      allow create, update: if isParent() && careShape('parent') && id.matches('^(med|appt|dose)_[A-Za-z0-9_-]{1,120}$');
      allow delete: if false;
    }
    match /households/family/careKid/{id} {
      allow read: if isParent() || (isKids() && !isKidRole())
                  || (isKidRole() && resource.data.own == myPid());
      allow create, update: if careShape('kid') && id.matches('^(med|appt|dose)_[A-Za-z0-9_-]{1,120}$') && (
        isParent()
        ||
        // kids' devices: only a new dose marked taken by a child ("k"), never a change to an existing one
        (isKids() && resource == null && id.matches('^dose_.+$')
                  && request.resource.data.st == 'k' && request.resource.data.deleted == false
                  && (!isKidRole() || request.resource.data.own == myPid()))
      );
      allow delete: if false;
    }

    // ---- wall tablet: unlock requests, unlock sessions, wall PIN ----
    match /households/family/unlockReq/{uid} {
      allow read, delete: if isParent() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid && isKids()
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.at is timestamp;
    }
    match /households/family/unlockSession/{uid} {
      function sessShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'proof', 'by', 'approvedBy', 'until', 'at'])
          && d.keys().hasAll(['kind', 'proof', 'by', 'approvedBy', 'until'])
          && d.until is timestamp
          && d.until > request.time
          && d.until <= request.time + duration.value(301, 's')
          && d.by is string && d.by.size() <= 100
          && d.proof is string && d.proof.size() <= 100
          && d.approvedBy is string && d.approvedBy.size() <= 128;
      }
      // the tablet may read only phone-approved sessions (a PIN session holds the PIN's proof)
      allow get: if isParent()
        || (request.auth != null && request.auth.uid == uid && resource.data.kind == 'phone');
      allow list: if isParent();
      allow delete: if isParent() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if sessShape() && (
        (isParent() && request.resource.data.kind == 'phone'
                    && request.resource.data.approvedBy == request.auth.uid)
        ||
        (request.auth != null && request.auth.uid == uid && isKids()
                    && request.resource.data.kind == 'pin'
                    && request.resource.data.approvedBy == ''
                    && request.resource.data.proof == wallHash())
      );
    }
    match /households/family/wall/{doc} {
      allow read: if isParent() || isKids();
      allow create, update: if isParent() && doc == 'pinSalt'
        && request.resource.data.keys().hasOnly(['salt', 'setBy', 'at'])
        && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
        && request.resource.data.setBy is string && request.resource.data.setBy.size() <= 100;
      allow delete: if false;
    }
    match /households/family/wallSecret/{doc} {
      allow read: if false;
      allow create, update: if isParent() && doc == 'pin'
        && request.resource.data.keys().hasOnly(['hash', 'setBy', 'at'])
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64
        && request.resource.data.setBy is string && request.resource.data.setBy.size() <= 100;
      allow delete: if false;
    }

    // Parent-only: PIN hashes, calendar links, AI helper address
    match /households/family/private/{pid} {
      allow read: if isParent();
      allow create, update: if isParent() && pid == 'main'
        && request.resource.data.keys().hasOnly(['json', 'rev'])
        && request.resource.data.keys().hasAll(['json', 'rev'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 100000
        && request.resource.data.rev is int
        && request.resource.data.rev == (resource == null ? 1 : resource.data.rev + 1);
      allow delete: if false;
    }
  }
}
